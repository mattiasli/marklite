---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Page not found | MarkLite" description="This page doesn't exist." path="/404" noindex>
  <Header />
  <main id="main" class="wrap missing">
    <p class="code">404</p>
    <h1>This page doesn't exist</h1>
    <p>The link may be old or mistyped.</p>
    <a class="btn btn-secondary" href="/">Back to MarkLite</a>
  </main>
  <Footer />
</Base>

<style>
  .missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-block: clamp(96px, 16vw, 180px);
    text-align: center;
  }

  .code {
    color: var(--brand);
    font-weight: 600;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }

  p:not(.code) {
    color: var(--ink-2);
  }

  .btn {
    margin-top: 8px;
  }
</style>
